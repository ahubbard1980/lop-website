---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lore — Leylines of Power" description="The world of Aetheris — stories, places, and powers of Leylines of Power.">
  <div class="content-bg">
    <section class="lore-wrap">
      <p class="eyebrow">Lore</p>
      <h1>Aureth's Watch</h1>

      <!-- Living illustration: the designer's motion study of Aureth's Watch
           at dawn — a slow camera drift over the painting with a pulsing
           sunrise, an arcane glow, and two drifting mist layers, all pure
           CSS over a single image. Every animation is disabled under
           prefers-reduced-motion. -->
      <div class="frame">
        <img class="art" src="/lore/aureths-watch.jpg" alt="Aureth's Watch at dawn" />
        <div class="sun"></div>
        <div class="arcane"></div>
        <div class="mist"></div>
        <div class="mist2"></div>
        <div class="vignette"></div>
      </div>

      <p class="caption">Aureth's Watch at dawn.</p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Same ambient background treatment as the Rules page — see
     src/pages/rules.astro / index.astro for the fuller comments. */
  .content-bg {
    position: relative;
    min-height: 100%;
  }
  .content-bg::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1659 / 948;
    z-index: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image: url('/ornaments/setup-bg.png');
    background-size: 100% 100%;
    background-position: center top;
    background-repeat: no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 68%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 68%, transparent 100%);
  }
  .lore-wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 24px 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  h1 {
    margin: 6px 0 18px;
    font-size: clamp(24px, 3.2vw, 34px);
    color: var(--gold-bright);
  }
  .caption {
    margin: 14px 0 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--muted-fg);
  }

  /* The motion study itself — ported from the designer's standalone HTML
     (index_embedded.html); geometry and timings kept verbatim, only the
     embedded data-URI art swapped for /lore/aureths-watch.jpg. */
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1671 / 941;
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(201, 169, 78, 0.35);
    border-radius: 8px;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.55);
  }
  .art {
    position: absolute;
    inset: -1.5%;
    width: 103%;
    height: 103%;
    object-fit: cover;
    transform-origin: 58% 48%;
    animation: camera 16s ease-in-out infinite alternate;
    will-change: transform;
  }
  .sun {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(circle at 82% 12%, rgba(255, 214, 128, 0.22), rgba(255, 183, 70, 0.08) 14%, transparent 32%);
    animation: sunPulse 6s ease-in-out infinite alternate;
  }
  .arcane {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(circle at 14.5% 53%, rgba(76, 167, 255, 0.22), rgba(63, 122, 255, 0.08) 7%, transparent 17%);
    filter: blur(1px);
    animation: arcanePulse 3.8s ease-in-out infinite alternate;
  }
  .mist,
  .mist2 {
    position: absolute;
    left: -35%;
    width: 170%;
    height: 28%;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 18% 48%, rgba(232, 238, 242, 0.18), transparent 34%),
      radial-gradient(ellipse at 53% 58%, rgba(226, 232, 238, 0.14), transparent 32%),
      radial-gradient(ellipse at 82% 42%, rgba(235, 238, 239, 0.12), transparent 28%);
    filter: blur(18px);
    opacity: 0.42;
    animation: mist 22s linear infinite alternate;
  }
  .mist {
    top: 43%;
  }
  .mist2 {
    top: 58%;
    opacity: 0.22;
    animation-duration: 29s;
    animation-direction: alternate-reverse;
  }
  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow:
      inset 0 0 110px rgba(0, 0, 0, 0.22),
      inset 0 -80px 120px rgba(0, 0, 0, 0.12);
  }
  @keyframes camera {
    0% {
      transform: scale(1.018) translate3d(-0.35%, 0.2%, 0);
    }
    48% {
      transform: scale(1.033) translate3d(0.15%, -0.1%, 0);
    }
    100% {
      transform: scale(1.025) translate3d(0.48%, -0.22%, 0);
    }
  }
  @keyframes sunPulse {
    from {
      opacity: 0.58;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes arcanePulse {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes mist {
    from {
      transform: translateX(-2.5%);
    }
    to {
      transform: translateX(4.5%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .art,
    .sun,
    .arcane,
    .mist,
    .mist2 {
      animation: none !important;
    }
  }
</style>
